{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Godot Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT4}", //"C:/Godot/Godot_v4.6.3-stable_mono_win64.exe"
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "args": ["--path","${workspaceRoot}"]
        }
    ]
}